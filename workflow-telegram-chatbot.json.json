    {
      "parameters": {
        "jsCode": "// Fallback determinístico: gera a mensagem final sem depender de IA\nreturn $input.all().map(item => {\n  const { cidade, temperatura, chatId } = item.json;\n  const message = `🌤️ A temperatura em ${cidade} é de ${temperatura}°C.`;\n  return { json: { chatId, cidade, temperatura, message, ok: true } };\n});"
      },
      "id": "1e7a1fc3-9c4e-464f-908a-0ea76788f12b",
      "name": "Formatar Mensagem (Fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        0
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Você é um meteorologista profissional e recebe uma mensagem sobre a temperatura atual de uma cidade brasileira.\nReescreva-a de forma natural, curta e amigável, em português do Brasil.\nRegras obrigatórias:\n- Mantenha exatamente o nome da cidade e o valor numérico da temperatura em °C.\n- Comece com o emoji 🌤️.\n- No máximo 1 frase.\n- Responda SOMENTE com JSON válido, sem markdown, no formato: {\"message\":\"...\",\"ok\":true}\n\nMensagem original: {{ $json.message }}"
      },
      "id": "6315343d-153d-4678-9412-8ad12c3732c3",
      "name": "Gemini - Melhorar Mensagem (opcional)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        1520,
        0
      ],
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "3840e7ed-3bf1-4110-8954-e57c56ee91c9",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1568,
        224
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "3egu4CLvdtS5BBnW",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Usa a mensagem do Gemini se ela for válida; caso contrário, usa o fallback.\n// Se o nó do Gemini estiver desativado, ele apenas repassa os dados do fallback.\nconst fallback = $('Formatar Mensagem (Fallback)').first().json;\nconst out = $input.first().json;\n\nlet message = fallback.message;\nlet source = 'fallback';\n\nif (typeof out.text === 'string' && out.text.trim()) {\n  try {\n    const cleaned = out.text.replace(/```json|```/g, '').trim();\n    const parsed = JSON.parse(cleaned);\n    const valido =\n      parsed &&\n      parsed.ok === true &&\n      typeof parsed.message === 'string' &&\n      parsed.message.trim().length > 0 &&\n      parsed.message.length <= 300 &&\n      parsed.message.includes(String(fallback.temperatura)); // evita temperatura \"inventada\"\n    if (valido) {\n      message = parsed.message.trim();\n      source = 'gemini';\n    }\n  } catch (e) {\n    // resposta inválida do Gemini -> mantém o fallback\n  }\n}\n\nreturn [{ json: { chatId: fallback.chatId, message, ok: true, source } }];"
      },
