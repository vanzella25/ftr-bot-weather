      "id": "636a95fb-33c8-4493-9454-46d5877dea86",
      "name": "Capturar Mensagem (queue)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// \"Corrige\" o formato aceito pela OpenWeather: cidade,uf,br.\n// Remove caracteres etc. \n\nreturn $input.all().map(item => {\n  const raw = String(item.json.queue ?? '');\n\n  let q = raw\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '') // remove acentos\n    .toLowerCase()                                     // minúsculas\n    .replace(/^\\/\\S*\\s*/, '')                          // ignora comandos como /start\n    .replace(/[^a-z0-9,'\\s-]/g, '')                    // remove caracteres inválidos\n    .replace(/\\s*,\\s*/g, ',')                          // remove espaços ao redor das vírgulas\n    .replace(/\\s+/g, ' ')                              // colapsa espaços repetidos\n    .trim()\n    .replace(/^,+|,+$/g, '');                          // remove vírgulas nas pontas\n\n  const parts = q.split(',').filter(Boolean);\n  // Garante o código do país (BR) no final\n  if (parts.length === 1 || (parts.length === 2 && parts[1] !== 'br')) {\n    parts.push('br');\n  }\n\n  return { json: { ...item.json, queue: parts.join(','), textoOriginal: raw } };\n});"
      },
      "id": "8a07f2cc-d39c-48ac-92dd-0913c395c7f3",
      "name": "Normalizar Cidade",
